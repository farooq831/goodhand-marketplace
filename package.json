{
  "name": "local-services-marketplace",
  "version": "0.1.0",
  "private": true,
  "description": "Two-sided marketplace connecting customers with local service providers (MERN stack).",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "check:server": "node server/checkSyntax.js",
    "seed:demo": "node server/seedDemo.js",
    "test": "npm test --workspace=server"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
